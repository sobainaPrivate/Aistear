source "https://rubygems.org"

gem "jekyll", "~> 3.10"
gem "kramdown-parser-gfm"

# Ruby 3.0+ dropped these from the standard library; Jekyll's local server needs them.
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"

# Windows file-watching for `jekyll serve` (avoids slow polling).
gem "wdm", ">= 0.1.0", platforms: [:windows]
